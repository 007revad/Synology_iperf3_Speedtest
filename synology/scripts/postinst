#!/bin/bash

PKG_NAME=$(basename "$SYNOPKG_PKGDEST")
TARGET_DIR="/var/packages/$PKG_NAME/target"
UI_DIR="$TARGET_DIR/ui"
BIN_DIR="$TARGET_DIR/bin"
SBIN_DIR="$TARGET_DIR/sbin"

# Get DSM major version
dsm=$(/usr/syno/bin/synogetkeyvalue /etc.defaults/VERSION majorversion)
if [[ $dsm -ge 7 ]]; then
    VAR_DIR="/var/packages/${PKG_NAME}/var"
else
    VAR_DIR="/var/packages/${PKG_NAME}/etc"
fi

# Log function
log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$VAR_DIR/install.log" 2>/dev/null || echo "$1"
}

echo "" >> "$VAR_DIR/install.log"

log_message "Post-installation starting for package: $PKG_NAME"
log_message "Running as $(id -un) (uid=$(id -u), gid=$(id -g))"

# Remove spurious files injected by the package builder
rm -f "$UI_DIR/Makefile"
rm -f "$UI_DIR/ui"  # self-referencing symlink
rm -f "$UI_DIR/texts/strings"  # strings file template
log_message "Removed spurious package builder files"

# Set execute permissions
chmod +x "$UI_DIR/api.cgi" 2>/dev/null
log_message "Set execute permissions for api.cgi"
chmod +x "$UI_DIR/stream.cgi" 2>/dev/null
log_message "Set execute permissions for stream.cgi"
chmod +x "$BIN_DIR/syno_iperf3_api.sh" 2>/dev/null
log_message "Set execute permissions for syno_iperf3_api.sh"
chmod +x "$BIN_DIR/syno_iperf3.sh" 2>/dev/null
log_message "Set execute permissions for syno_iperf3.sh"
chmod +x "$BIN_DIR/task_setup.sh" 2>/dev/null
log_message "Set execute permissions for task_setup.sh"
chmod +x "$BIN_DIR/syno_discover.py" 2>/dev/null
log_message "Set execute permissions for syno_discover.py"


if [ -z "$ERRORS" ]; then
    log_message "Post-installation completed successfully"
else
    log_message "Post-installation completed with warnings"
fi
echo >> "$VAR_DIR/install.log"
exit 0
